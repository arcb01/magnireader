<Window x:Class="MagniReader.UI.PlaybackStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MagniReader playback"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Same look as the control bar. Icons: Segoe Fluent Icons (Windows 11), else Segoe MDL2 Assets. -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="StripButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#313244" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#45475A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small "10" next to the rewind / forward arrows -->
        <Style x:Key="SecondsLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow -->
    <Border x:Name="Root" Margin="6" Background="#1E1E2E" CornerRadius="9"
            BorderBrush="#45475A" BorderThickness="1" Padding="3">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="RewindButton" Style="{StaticResource StripButton}" Click="RewindButton_Click"
                    ToolTip="Back 10 seconds">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEB9E;" FontSize="13" VerticalAlignment="Center" Margin="0,0,3,0" />
                    <TextBlock Text="10" Style="{StaticResource SecondsLabel}" />
                </StackPanel>
            </Button>

            <Button x:Name="PlayPauseButton" Style="{StaticResource StripButton}" Click="PlayPauseButton_Click"
                    ToolTip="Pause" MinWidth="38">
                <TextBlock x:Name="PlayPauseGlyph" Text="&#xE769;" FontSize="16" Foreground="#FFD700" />
            </Button>

            <Button x:Name="ForwardButton" Style="{StaticResource StripButton}" Click="ForwardButton_Click"
                    ToolTip="Forward 10 seconds">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="10" Style="{StaticResource SecondsLabel}" Margin="0,0,3,0" />
                    <TextBlock Text="&#xEB9D;" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Reading speed: each click moves to the next speed (1x, 1.25x, 1.5x, 2x, 0.75x) -->
            <Button x:Name="SpeedButton" Style="{StaticResource StripButton}" Click="SpeedButton_Click"
                    MinWidth="48" ToolTip="Reading speed (click for the next speed)"
                    AutomationProperties.Name="Reading speed">
                <TextBlock x:Name="SpeedText" Text="1x" FontFamily="Segoe UI" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </Button>

            <Rectangle Width="1" Height="18" Margin="4,0" Fill="#45475A" />

            <Button x:Name="StopButton" Style="{StaticResource StripButton}" Click="StopButton_Click"
                    ToolTip="Stop reading (Esc)">
                <TextBlock Text="&#xE71A;" FontSize="13" />
            </Button>
        </StackPanel>
    </Border>
</Window>
