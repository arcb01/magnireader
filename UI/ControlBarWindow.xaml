<Window x:Class="MagniReader.UI.ControlBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MagniReader"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Icon glyphs come from Segoe Fluent Icons (Windows 11), falling back to Segoe MDL2 Assets (Windows 10). -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#313244" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#45475A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Fill" Value="#45475A" />
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the drop shadow -->
    <Border Margin="8" Background="#1E1E2E" CornerRadius="10"
            BorderBrush="#45475A" BorderThickness="1" Padding="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

            <!-- Drag handle -->
            <Border x:Name="DragHandle" Background="Transparent" Cursor="SizeAll"
                    Padding="6,0,4,0" ToolTip="Drag to move"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="#6C7086" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="MagniReader" FontSize="12" FontWeight="SemiBold"
                               Foreground="#FFD700" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Rectangle Style="{StaticResource Divider}" />

            <!-- Read: the next click on any text reads it (no Ctrl+Alt needed) -->
            <Button x:Name="ReadButton" Style="{StaticResource BarButton}" Click="ReadButton_Click"
                    ToolTip="Read: click this, then click any text (or Ctrl+Alt+Click anytime)">
                <TextBlock x:Name="ReadGlyph" Text="&#xE768;" />
            </Button>
            <Button x:Name="StopButton" Style="{StaticResource BarButton}" Click="StopButton_Click"
                    ToolTip="Stop reading (Esc)" IsEnabled="False">
                <TextBlock Text="&#xE71A;" />
            </Button>

            <Rectangle Style="{StaticResource Divider}" />

            <!-- Speed -->
            <Button x:Name="SlowerButton" Style="{StaticResource BarButton}" Click="SlowerButton_Click"
                    ToolTip="Slower">
                <TextBlock Text="&#xE738;" FontSize="12" />
            </Button>
            <TextBlock x:Name="SpeedText" Text="Speed +1" FontSize="12" Foreground="#CDD6F4"
                       VerticalAlignment="Center" MinWidth="58" TextAlignment="Center"
                       ToolTip="Reading speed (-10 to +10)" />
            <Button x:Name="FasterButton" Style="{StaticResource BarButton}" Click="FasterButton_Click"
                    ToolTip="Faster">
                <TextBlock Text="&#xE710;" FontSize="12" />
            </Button>

            <Rectangle Style="{StaticResource Divider}" />

            <!-- Engine toggle -->
            <Button x:Name="EngineButton" Style="{StaticResource BarButton}" Click="EngineButton_Click"
                    FontFamily="Segoe UI" FontSize="12" MinWidth="76"
                    ToolTip="Voice engine: click to switch between Windows and Kokoro voices">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="EngineText" Text="Windows" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Screenshot analysis -->
            <Button x:Name="SnipButton" Style="{StaticResource BarButton}" Click="SnipButton_Click"
                    ToolTip="Describe a screen area with AI (Ctrl+Alt+S)">
                <TextBlock Text="&#xE722;" />
            </Button>

            <Rectangle Style="{StaticResource Divider}" />

            <Button x:Name="SettingsButton" Style="{StaticResource BarButton}" Click="SettingsButton_Click"
                    ToolTip="Settings">
                <TextBlock Text="&#xE713;" />
            </Button>
            <Button x:Name="MinimizeButton" Style="{StaticResource BarButton}" Click="MinimizeButton_Click"
                    ToolTip="Hide to tray (double-click the tray icon to bring it back)">
                <TextBlock Text="&#xE921;" FontSize="12" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource BarButton}" Click="CloseButton_Click"
                    ToolTip="Exit MagniReader">
                <TextBlock Text="&#xE8BB;" FontSize="12" />
            </Button>
        </StackPanel>
    </Border>
</Window>
