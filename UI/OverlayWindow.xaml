<Window x:Class="MagniReader.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MagniReader Overlay"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Normal"
        ResizeMode="NoResize"
        Visibility="Collapsed">

    <Canvas x:Name="OverlayCanvas">
        <!-- Full-screen dim -->
        <Rectangle x:Name="DimBackground" Fill="#99000000" />

        <!-- Cutout dim rects -->
        <Rectangle x:Name="DimTop"    Fill="#99000000" />
        <Rectangle x:Name="DimBottom" Fill="#99000000" />
        <Rectangle x:Name="DimLeft"   Fill="#99000000" />
        <Rectangle x:Name="DimRight"  Fill="#99000000" />

        <!-- Highlight border around the text element -->
        <Border x:Name="HighlightBorder"
                BorderThickness="2"
                CornerRadius="4"
                Visibility="Collapsed">
            <Border.BorderBrush>
                <SolidColorBrush x:Name="HighlightBrush" Color="#FFD700" />
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="#FFD700" BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
            </Border.Effect>
            <Border Background="Transparent" />
        </Border>

        <!-- Box over the word being spoken. Moves from word to word as speech advances. -->
        <Border x:Name="WordBox"
                BorderThickness="2"
                CornerRadius="3"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Border.BorderBrush>
                <SolidColorBrush x:Name="WordBoxBorderBrush" Color="#FFD700" />
            </Border.BorderBrush>
            <Border.Background>
                <SolidColorBrush x:Name="WordBoxFillBrush" Color="#FFD700" Opacity="0.25" />
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect x:Name="WordBoxGlow" Color="#FFD700" BlurRadius="10" ShadowDepth="0" Opacity="0.6" />
            </Border.Effect>
        </Border>

    </Canvas>
</Window>
