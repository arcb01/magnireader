<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Only copy the Windows x64 native libraries (ONNX Runtime ships ~180 MB for other platforms) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts -->
    <StartupObject>MagniReader.Program</StartupObject>
    <!-- Overridden by the Release workflow from the git tag (v1.2.3 -> 1.2.3).
         Local builds stay 0.0.0-dev so they never claim to be a released version. -->
    <Version>0.0.0-dev</Version>
    <Product>MagniReader</Product>
    <!-- Exclude non-code directories from compilation -->
    <DefaultItemExcludes>$(DefaultItemExcludes);scripts\**;tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <!-- Kokoro offline neural TTS (ONNX Runtime on CPU). Its voices are copied to the output "voices" folder. -->
    <PackageReference Include="KokoroSharp.CPU" Version="0.8.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <!-- Installer (Setup.exe), shortcuts and auto-updates from GitHub Releases -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- GPU voices: Python server, pinned requirements and the reference voice clips.
         Python, PyTorch and the models themselves are installed on demand from Settings. -->
    <Content Include="GpuTts\**\*" Exclude="GpuTts\**\__pycache__\**;GpuTts\**\*.md;GpuTts\bench\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- App logo shown inside the UI (Settings header, About, control bar) -->
    <Resource Include="assets\magnireader.png" />
  </ItemGroup>

  <!-- KokoroSharp copies its voices into the build output only (AfterTargets="Build"),
       so `dotnet publish` (used by the Release workflow and so by Setup.exe) left them out.
       Copy the English and Spanish voices (the only ones MagniReader offers) and their
       licence into the publish folder too. -->
  <Target Name="PublishKokoroVoices" AfterTargets="Publish">
    <ItemGroup>
      <_KokoroVoiceFile Include="$(OutputPath)voices\a?_*.npy;$(OutputPath)voices\b?_*.npy;$(OutputPath)voices\e?_*.npy;$(OutputPath)voices\LICENSE" />
    </ItemGroup>
    <Copy SourceFiles="@(_KokoroVoiceFile)" DestinationFolder="$(PublishDir)voices" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)voices\af_heart.npy') Or !Exists('$(PublishDir)voices\ef_dora.npy')"
           Text="Kokoro voices are missing from the publish folder ($(PublishDir)voices)." />
  </Target>

</Project>
