<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Only copy the Windows x64 native libraries (ONNX Runtime ships ~180 MB for other platforms) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts -->
    <StartupObject>MagniReader.Program</StartupObject>
    <!-- Overridden by the Release workflow from the git tag (v1.2.3 -> 1.2.3) -->
    <Version>1.0.0</Version>
    <Product>MagniReader</Product>
    <!-- Exclude non-code directories from compilation -->
    <DefaultItemExcludes>$(DefaultItemExcludes);scripts\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <!-- Kokoro offline neural TTS (ONNX Runtime on CPU). Its voices are copied to the output "voices" folder. -->
    <PackageReference Include="KokoroSharp.CPU" Version="0.8.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <!-- Installer (Setup.exe), shortcuts and auto-updates from GitHub Releases -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
